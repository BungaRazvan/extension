{
  "name": "extension",
  "version": "1.0.0",
  "main": "background.js",
  "scripts": {
    "copy:css": "cp -r src/css dist/",
    "copy:man": "cp -r manifest.json dist/",
    "copy:html": "cp -r src/html dist/",
    "build": "npm run copy:man && npm run copy:html && npm run copy:css && esbuild src/*.js --bundle --outdir=dist",
    "watch": "chokidar 'src/**/*' 'manifest.json' '*.html' 'css/**/*' -c \"npm run build\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.25.10"
  }
}
