{
  "name": "extension",
  "description": "Custom features",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["youtube.js"],
      "css": ["css/youtube.css"],
      "matches": [
        "https://www.youtube.com/",
        "https://www.youtube.com/watch?v=*",
        "https://www.youtube.com/playlist?list=*"
      ]
    }
  ],
  "permissions": ["storage", "contextMenus", "tabs", "bookmarks", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8000/*",
    "https://backbone.razvan.app"
  ]
}
